{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Misaoys/coding-rules-guard/contracts/run-state.schema.json",
  "title": "Coding Rules Guard run state",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "phase",
    "goal",
    "write_scope",
    "changed_files",
    "evidence",
    "risk",
    "result",
    "delivery_required",
    "gaps_authorized",
    "gap_authorization",
    "rework_count",
    "last_rework_reason",
    "rework_streak",
    "replan_required",
    "plan_revision",
    "repo",
    "git_baseline",
    "change_detection",
    "delivery_audit",
    "review_required",
    "planner_profile",
    "plan_record",
    "executor_profile",
    "reviewer_profile",
    "review"
  ],
  "properties": {
    "schema_version": { "const": 4 },
    "run_id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["FAST", "FULL"] },
    "phase": { "enum": ["plan", "implement", "verify", "deliver", "complete"] },
    "goal": { "type": "string", "minLength": 1 },
    "write_scope": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "changed_files": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "entry", "command", "observed", "level", "result"],
        "properties": {
          "kind": { "enum": ["success", "boundary"] },
          "entry": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "observed": { "type": "string", "minLength": 1 },
          "level": { "enum": ["source", "test", "browser", "installed", "host", "production"] },
          "result": { "enum": ["pass", "fail", "blocked"] }
        },
        "additionalProperties": false
      }
    },
    "risk": {
      "type": "object",
      "required": ["impact", "details"],
      "properties": {
        "impact": { "enum": ["no_known_impact", "known_impact", "unverified"] },
        "details": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "result": { "enum": ["pending", "pass", "pass_with_gaps", "blocked", "fail"] },
    "gaps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "delivery_required": { "type": "boolean" },
    "gaps_authorized": { "type": "boolean" },
    "gap_authorization": {
      "type": ["object", "null"],
      "properties": {
        "authorization_id": { "type": "string", "minLength": 1 },
        "authorized_by": { "type": "string", "pattern": "^(user|host):" },
        "authorized_at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "required": ["authorization_id", "authorized_by", "authorized_at", "reason"],
      "additionalProperties": false
    },
    "rework_count": { "type": "integer", "minimum": 0 },
    "last_rework_reason": { "type": ["string", "null"] },
    "rework_streak": { "type": "integer", "minimum": 0 },
    "replan_required": { "type": "boolean" },
    "plan_revision": { "type": "integer", "minimum": 1 },
    "plan_file": { "type": ["string", "null"] },
    "repo": { "type": "string", "minLength": 1 },
    "git_baseline": {
      "type": "object",
      "properties": {
        "head": { "type": "string", "minLength": 1 },
        "files": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "content_files": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "index_files": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["head", "files", "content_files", "index_files"],
      "additionalProperties": false
    },
    "change_detection": { "const": "git_baseline" },
    "review_required": { "type": "boolean" },
    "planner_profile": { "type": "string", "minLength": 1 },
    "plan_record": {
      "type": ["object", "null"],
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "reasoning_effort": { "type": "string", "minLength": 1 },
        "recorded_at": { "type": "string", "format": "date-time" },
        "plan_revision": { "type": "integer", "minimum": 1 },
        "plan_fingerprint": { "type": "string", "minLength": 1 }
      },
      "required": [
        "profile",
        "model",
        "reasoning_effort",
        "recorded_at",
        "plan_revision",
        "plan_fingerprint"
      ],
      "additionalProperties": false
    },
    "executor_profile": { "type": ["string", "null"], "minLength": 1 },
    "reviewer_profile": { "type": "string", "minLength": 1 },
    "review": {
      "type": ["object", "null"],
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "reasoning_effort": { "type": "string", "minLength": 1 },
        "result": { "enum": ["pass", "fail", "blocked"] },
        "observed": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "task_fingerprint": { "type": "string", "minLength": 1 }
      },
      "required": ["profile", "model", "reasoning_effort", "result", "observed", "reviewed_at", "task_fingerprint"],
      "additionalProperties": false
    },
    "delivery_audit": {
      "type": ["object", "null"],
      "properties": {
        "passed": { "type": "boolean" },
        "repo": { "type": "string" },
        "checked_files": { "type": "array", "items": { "type": "string" } },
        "task_fingerprint": { "type": "string", "minLength": 1 }
      },
      "required": ["passed", "repo", "checked_files", "task_fingerprint"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
